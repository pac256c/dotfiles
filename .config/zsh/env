# ~/.config/zsh/env - environment shared by all shells (zsh and bash).
#
# Sourced from:
#   - /etc/zsh/zshenv           (zsh: every shell, added by arch/extra.sh;
#                               covers nested shells that inherit ZDOTDIR)
#   - ~/.zshenv                (zsh: fallback where /etc/zshenv has no line)
#   - ~/.config/bash/rc        (bash: every mode via the .bash_profile/.bashrc
#                               stubs; also $BASH_ENV for non-interactive)
#
# Keep this file POSIX: exports and tests that work in both bash and zsh.
# Zsh-only bits (e.g. `typeset -U path`) belong in ~/.zshenv.

# XDG home paths
export XDG_DATA_HOME=$HOME/.local/share
export XDG_CACHE_HOME=$HOME/.cache
export XDG_CONFIG_HOME=$HOME/.config
export XDG_STATE_HOME=$HOME/.local/state
export XDG_BIN_DIR=$HOME/.local/bin
export XDG_TEMPLATES_DIR=$HOME/templates
export XDG_PUBLICSHARE_DIR=$HOME/public
export XDG_DOCUMENTS_DIR=$HOME/documents
export XDG_MUSIC_DIR=$HOME/music
export XDG_PICTURES_DIR=$HOME/pictures
export XDG_VIDEOS_DIR=$HOME/videos
export XDG_DESKTOP_DIR=$HOME/desktop
export XDG_DOWNLOAD_DIR=$HOME/downloads
export XDG_GAMES_DIR=$HOME/games
if [ -d /run/user/$UID ]; then
  export XDG_RUNTIME_DIR=/run/user/$UID
else
  # dangling value (inherited from login/tmux) breaks nvim's RPC server
  unset XDG_RUNTIME_DIR
fi

# reroute program paths
export ZDOTDIR=$XDG_CONFIG_HOME/zsh
export GVIMINIT="so $XDG_CONFIG_HOME/nvim/init.lua"
export VIMINIT="so $XDG_CONFIG_HOME/nvim/init.lua"
export WGETRC=$XDG_CONFIG_HOME/wget/wgetrc
export WGET_HISTS=$XDG_DATA_HOME/wget-hsts
export LESSHISTFILE=$XDG_STATE_HOME/lesshst
export HISTFILE=$XDG_STATE_HOME/bash/history
export NVM_DIR=$XDG_DATA_HOME/nvm
export NPM_CONFIG_INIT_MODULE=$XDG_CONFIG_HOME/npm/config/npm-init.js
export NPM_CONFIG_CACHE=$XDG_CACHE_HOME/npm
export PYTHONSTARTUP=$XDG_CONFIG_HOME/python/pythonrc.py
export PYTHON_HISTORY=$XDG_STATE_HOME/python/history
export TS_NODE_HISTORY=$XDG_STATE_HOME/ts_node_repl_history
export OCTAVE_HISTFILE=$XDG_STATE_HOME/octave_hist
export CONDARC=$XDG_CONFIG_HOME/conda/condarc
export CONDA_PREFIX=$HOME/.local/opt/miniforge3
export _JAVA_OPTIONS=-Djava.util.prefs.userRoot=$XDG_CONFIG_HOME/java
export NODE_REPL_HISTORY=$XDG_STATE_HOME/node_repl_history
export RUSTUP_HOME=$HOME/.local/opt/rustup
export CARGO_HOME=$HOME/.local/opt/cargo
export GOPATH=$HOME/.local/opt/go
export GNUPGHOME=$XDG_DATA_HOME/gnupg
export OPENCODE_CONFIG_DIR=$XDG_CONFIG_HOME/opencode
export OPENCODE_CONFIG=$XDG_CONFIG_HOME/opencode/opencode.json
export BASH_ENV=$XDG_CONFIG_HOME/zsh/env
export NOVAS_GUICONF=$XDG_CONFIG_HOME/synopsys/novas.conf
export NOVAS_RC=$XDG_CONFIG_HOME/synopsys/novas.rc
export TMUX_TMPDIR=$XDG_STATE_HOME/tmux
export DOTNET_CLI_HOME=$XDG_STATE_HOME/dotnet
export NUGET_PACKAGES=$XDG_DATA_HOME/nuget
export DOTNET_NUGET_CACHE=$XDG_CACHE_HOME/nuget
export ESD_AUTH=$XDG_CONFIG_HOME/esd_auth
export JFROG_CLI_HOME_DIR=$XDG_CONFIG_HOME/jfrog
export QT_CONF_PATH=$XDG_CONFIG_HOME/qt/qt.conf
export SVN_CONFIG_DIR=$XDG_CONFIG_HOME/subversion
export NVIM_NOTTYFAST=1

# edit path variable (only add directories that exist)
path_append() { [[ -d "$1" ]] && export PATH="${PATH:+$PATH:}$1"; }
path_append $CARGO_HOME/bin
path_append $OPENCODE_CONFIG_DIR/bin
path_append $GOPATH/bin
path_append /opt/cuda/bin
path_append $HOME/.local/bin
path_append $HOME/.local/lib/binutils-2.39/bin
path_append $HOME/.local/lib/nvim/bin
path_append $HOME/.local/opt/cargo/bin
path_append $HOME/.local/opt/musl/bin

# Conda's activation prepends its bin/, so conda-installed programs shadow
# system/global ones. For tools that exist outside conda too (kitty, git, ...)
# we want the global build to win; keep conda as a fallback instead. Call this
# after `conda activate` to move conda's dirs to the end of $PATH and drop
# duplicate entries (repeated activations re-prepend without removing).
# (POSIX-only: this file is shared by bash and zsh, so avoid array/read -a.)
conda_defer_path() {
  [ -n "$CONDA_PREFIX" ] || return 0
  # Drop the active env's dirs and any duplicates (keep first occurrence),
  # then append the active env's real dirs at the very end. Entries are
  # whitespace-trimmed first (a stray newline can sneak in on activation).
  PATH=$(printf '%s' "$PATH" | awk -v RS=: \
    -v cb="$CONDA_PREFIX/bin" -v cc="$CONDA_PREFIX/condabin" '
    { gsub(/^[ \t\r\n]+|[ \t\r\n]+$/, "", $0) }
    $0 == cb || $0 == cc { next }
    seen[$0]++ { next }
    { printf "%s%s", sep, $0; sep = ":" }')
  [ -d "$CONDA_PREFIX/bin" ] && PATH="${PATH:+$PATH:}$CONDA_PREFIX/bin"
  [ -d "$CONDA_PREFIX/condabin" ] && PATH="${PATH:+$PATH:}$CONDA_PREFIX/condabin"
  export PATH
  hash -r 2>/dev/null || true
}

# remove duplicates from $PATH if they exist
export PATH=$(echo "$PATH" | awk -v RS=: -v ORS=: '!a[$0]++' | sed 's/:$//')
