#choose one language of read-eval-print loop (REPL)  
repl() {
  local input
  local valid=false

  # Define the data: alternating human-readable label and a short internal key.
  declare -A OPTIONS=(
    [Python]="python"
    [TS]="ts"
    [JS]="js"
    [C++]="c++"
    [Octave]="octave"
    [Java]="java"
  )

  while [ "$valid" = false ]; do
    echo "Please choose one of the following (type the name):"
    for label in "${OPTIONS[@]}"; do
      echo "  - ${label}"
    done
    printf "> "
    read -r input

    # Normalise to lowercase for case-insensitive matching.
    input=$(echo "$input" | tr '[:upper:]' '[:lower:]')

    case "$input" in
      "${OPTIONS[Python]}")
        python
        valid=true
        ;;
      "${OPTIONS[TS]}")
        echo "Starting BUN Typescript Read-Eval-Print Loop (REPL)"
        bun repl
        rm -f ~/.bun_repl_history
        valid=true
        ;;
      "${OPTIONS[JS]}")
        node
        valid=true
        ;;
      "${OPTIONS[C++]}")
        pushd /opt/cling-build/bin
        ./cling -include stdio.h -include stdlib.h -include string.h -include math.h -include stdbool.h -include stdint.h -include ctype.h -include time.h -include assert.h -include errno.h
        popd
        rm -f ~/.clang-repl-history
        valid=true
        ;;
      "${OPTIONS[Octave]}")
        octave
        valid=true
        ;;
      "${OPTIONS[Java]}")
        jshell
        valid=true
        ;;
      *)
        echo "Invalid choice — please pick one of the listed options."
        echo ""
        ;;
    esac
  done
}
