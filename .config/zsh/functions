# Run a command from a specific conda env, activating it first and restoring
# the previously active env afterward. Used by repl() for languages whose tools
# live in their own env (clang-repl in "clang", octave in "octave") because
# installing them into base would downgrade/conflict with the base toolchain.
# Leaves PATH ordering (conda_defer_path) intact. If the env is unavailable,
# falls back to running the command as-is (works if it's already on PATH).
_conda_env_run() {
  local env="$1" cmd="$2"; shift 2
  local prev_env="${CONDA_DEFAULT_ENV:-}"
  local have_env=false
  if command -v conda >/dev/null 2>&1 \
     && conda env list 2>/dev/null | awk '{print $1}' | grep -qx "$env"; then
    have_env=true
  fi

  if $have_env; then
    conda activate "$env" >/dev/null 2>&1 || {
      echo "$cmd: failed to activate '$env' env" >&2
      return 1
    }
    hash -r 2>/dev/null
    "$cmd" "$@"
    local rc=$?
    if [ -n "$prev_env" ]; then
      conda activate "$prev_env" >/dev/null 2>&1
    else
      conda deactivate >/dev/null 2>&1
    fi
    hash -r 2>/dev/null
    type conda_defer_path >/dev/null 2>&1 && conda_defer_path
    return $rc
  fi

  if command -v "$cmd" >/dev/null 2>&1; then
    "$cmd" "$@"
  else
    echo "$cmd not found. Run 'dotfiles pull' to create the '$env' conda env." >&2
    return 127
  fi
}

# convenience wrapper preserved for the C/C++ cases.
_clang_repl() { _conda_env_run clang clang-repl "$@"; }


#choose one language of read-eval-print loop (REPL)  
repl() {
  local input
  local valid=false

  # Define the data: alternating human-readable label and a short internal key.
  declare -A OPTIONS=(
    [Python]="python"
    [TS]="ts"
    [JS]="js"
    [C++]="c++"
    [C]="c"
    [Octave]="octave"
    [Java]="java"
  )

  while [ "$valid" = false ]; do
    echo "Please choose one of the following (type the name):"
    for label in "${OPTIONS[@]}"; do
      echo "  - ${label}"
    done
    printf "> "
    read -r input

    # Normalise to lowercase for case-insensitive matching.
    input=$(echo "$input" | tr '[:upper:]' '[:lower:]')

    case "$input" in
      "${OPTIONS[Python]}")
        # conda's python is the one with the PYTHONSTARTUP imports (pint/numpy),
        # but conda's bin is deferred to the end of PATH, so bare `python3` would
        # pick the system interpreter. Use conda's explicitly.
        if [ -x "${CONDA_PREFIX:-$HOME/.local/opt/miniforge3}/bin/python3" ]; then
          "${CONDA_PREFIX:-$HOME/.local/opt/miniforge3}/bin/python3"
        else
          python3
        fi
        valid=true
        ;;
      "${OPTIONS[TS]}")
        echo "Starting BUN Typescript Read-Eval-Print Loop (REPL)"
        bun repl
        rm -f ~/.bun_repl_history
        valid=true
        ;;
      "${OPTIONS[JS]}")
        node
        valid=true
        ;;
      "${OPTIONS[C++]}")
        echo -e "\e[1;32m=== Entering C++ REPL ===\e[0m"
        HOME=$XDG_CACHE_HOME _clang_repl -Xcc=-include -Xcc="$XDG_CONFIG_HOME/clang-repl/cpp_init.h"
        valid=true
        ;;
      "${OPTIONS[C]}")
        echo -e "\e[1;36m=== Entering Plain C REPL ===\e[0m"
        HOME=$XDG_CACHE_HOME _clang_repl --Xcc=-x --Xcc=c -Xcc=-include -Xcc="$XDG_CONFIG_HOME/clang-repl/c_init.h"
        valid=true
        ;;
      "${OPTIONS[Octave]}")
        # --no-line-editing: octave's bundled readline line editor doesn't
        # accept input in this environment (WSL2 + conda pty) -- it shows the
        # prompt but swallows keystrokes, leaving ctrl-z as the only way out.
        # Disabling it makes octave read the terminal directly.
        _conda_env_run octave octave --no-line-editing
        valid=true
        ;;
      "${OPTIONS[Java]}")
        jshell
        valid=true
        ;;
      *)
        echo "Invalid choice — please pick one of the listed options."
        echo ""
        ;;
    esac
  done
}

# general-purpose open function based on yazi.toml open file choices.
# uses python inline to determine what to open the file with
o() {
    if [ -z "$1" ]; then
        echo "Usage: o <filename>"
        return 1
    fi

    local target_file="$1"
    local config_file="$HOME/.config/yazi/yazi.toml"

    if [ ! -f "$target_file" ]; then
        echo "Error: File '$target_file' not found."
        return 1
    fi
    if [ ! -f "$config_file" ]; then
        echo "Error: yazi.toml not found at $config_file"
        return 1
    fi

    # Determine file attributes for matching rules
    local ext="${target_file##*.}"
    [[ "$target_file" != *.* ]] && ext=""
    local mime_type
    mime_type=$(file --mime-type -b "$target_file" 2>/dev/null)

    # Parse yazi.toml rules via Python. stdout carries the result as two
    # space-separated fields: "<orphan 0|1> <command>". Menu/prompt output
    # goes to stderr. The selection prompt is read from the controlling
    # terminal; if there is none, the last rule wins by default.
    local result
    result=$(EXT="$ext" MIME="$mime_type" CONF="$config_file" python3 - <<'PY'
import fnmatch, os, sys

try:
    import tomllib
except ModuleNotFoundError:
    try:
        import tomli as tomllib
    except ModuleNotFoundError:
        sys.exit(3)

ext = os.environ.get('EXT', '')
mime = os.environ.get('MIME', '')
config_path = os.environ.get('CONF', '')

try:
    with open(config_path, 'rb') as f:
        config = tomllib.load(f)
except Exception:
    sys.exit(1)

openers = config.get('opener', {})
rules = config.get('open', {}).get('prepend_rules', [])

matched_uses = []

# Find first matching rule by extension or MIME type
for rule in rules:
    rule_url = rule.get('url', '')
    rule_mime = rule.get('mime', '')

    if rule_url and ext and fnmatch.fnmatch('file.' + ext, rule_url):
        use = rule.get('use', [])
        matched_uses = use if isinstance(use, list) else [use]
        break
    elif rule_mime and mime and (fnmatch.fnmatch(mime, rule_mime) or mime == rule_mime):
        use = rule.get('use', [])
        matched_uses = use if isinstance(use, list) else [use]
        break

# Resolve rule keys to executable command objects
final_commands = []
for use_key in matched_uses:
    for op in openers.get(use_key, []):
        run_str = op.get('run', '')
        if not run_str:
            continue
        # Strip Yazi's %s / %* parameter tokens from the raw command
        clean_cmd = run_str.replace(' %s', '').replace(' %*', '').replace(' "$@"', '').replace(' $@', '')
        final_commands.append({
            'cmd': clean_cmd,
            'desc': op.get('desc', use_key),
            'orphan': bool(op.get('orphan', False)),
        })

if not final_commands:
    sys.exit(0)

# Single match: use it directly. Multiple: prompt for a choice.
if len(final_commands) == 1:
    chosen = final_commands[0]
else:
    print('Multiple openers found for this file type. Select one:', file=sys.stderr)
    for idx, item in enumerate(final_commands, 1):
        print('  [{}] {} ({})'.format(idx, item['desc'], item['cmd']), file=sys.stderr)

    chosen = None
    try:
        print('Enter selection (1-{}): '.format(len(final_commands)),
              end='', file=sys.stderr, flush=True)
        with open('/dev/tty', 'r') as tty:
            choice = tty.readline().strip()
        if choice:
            ci = int(choice) - 1
            if 0 <= ci < len(final_commands):
                chosen = final_commands[ci]
            else:
                print('Invalid selection. Aborting.', file=sys.stderr)
                sys.exit(1)
    except Exception:
        pass

    # No controlling terminal, EOF, or invalid input: default to first rule
    if chosen is None:
        chosen = final_commands[0]

print('{} {}'.format(1 if chosen['orphan'] else 0, chosen['cmd']))
PY
)
    local rc=$?

    if (( rc != 0 )); then
        return 1
    fi

    # Fallback to system text editor if no specific mappings were processed
    if [ -z "$result" ]; then
        echo "No explicit rule found in yazi.toml. Defaulting to system \$EDITOR..."
        eval "${EDITOR:-nvim} \"\$target_file\""
        return
    fi

    # result = "<orphan 0|1> <command...>"; split off the first field
    local orphan_flag="${result%% *}"
    local selected_cmd="${result#* }"

    # Run the matched program, backgrounding apps flagged orphan in yazi.toml
    if [ "$orphan_flag" = "1" ]; then
        eval "$selected_cmd \"\$target_file\" &"
    else
        eval "$selected_cmd \"\$target_file\""
    fi
}

# dotfiles - wrap git for the bare dotfiles repo at ~/.config/dotfiles
# (work-tree = $HOME). Precedence: if conda is present use the local (conda)
# flow; otherwise if pacman is present use the arch (yay) flow.
# `push` regenerates + commits the corresponding packages.txt (and, for the
# local flow, one envs/<name>.txt per extra conda env) from each env's
# explicitly-requested packages (minus locally-built manlist.txt packages);
# `pull` runs the matching sync.sh afterward.
dotfiles() {
  local gitdir="$HOME/.config/dotfiles"
  local worktree="$HOME"
  local g=(git --git-dir="$gitdir" --work-tree="$worktree")
  local flow=""  # "local" or "arch"
  local conda=""
  if [[ -x "$HOME/.local/opt/miniforge3/bin/conda" ]]; then
    conda="$HOME/.local/opt/miniforge3/bin/conda"
    flow="local"
  elif command -v conda >/dev/null 2>&1; then
    conda="$(command -v conda)"
    flow="local"
  elif command -v pacman >/dev/null 2>&1; then
    flow="arch"
  fi

  if [[ "$1" == "push" && "$flow" == "local" ]]; then
    local pkgfile="$gitdir/local/packages.txt"
    local manlist="$gitdir/local/manlist.txt"
    # Extract the explicitly-requested packages of a conda env, using
    # `conda env export --from-history` (installed-state based, so removed
    # packages like a previously-tried `root` don't linger). Strips version
    # pins/build suffixes and internal bootstrap packages (conda/mamba/pip/
    # python), and drops locally-built manlist.txt packages.
    # $1 = env name. Prints sorted names to stdout.
    _dotfiles_env_specs() {
      local ename="$1" ml="$manlist"
      [[ -n "$ename" ]] || return 0
      {
        "$conda" env export -n "$ename" --from-history 2>/dev/null \
          | awk '
              /^dependencies:/ { deps=1; next }
              /^[A-Za-z_]+:/   { deps=0 }
              deps && /^[[:space:]]*-[[:space:]]/ { sub(/^[[:space:]]*-[[:space:]]*/, ""); print }
            ' \
          | sed -E 's/^([A-Za-z0-9_.-]+).*/\1/' \
          | grep -vE '^(conda|mamba|pip|python)$'
      } | sort -u > /tmp/dotfiles-packages.txt
      if [[ -f "$ml" ]]; then
        grep -vE '^[[:space:]]*#' "$ml" | awk '{print $1}' | sort -u > /tmp/dotfiles-manlist.txt
        grep -vxFf /tmp/dotfiles-manlist.txt /tmp/dotfiles-packages.txt > /tmp/dotfiles-packages.filtered
        mv /tmp/dotfiles-packages.filtered /tmp/dotfiles-packages.txt
      fi
      cat /tmp/dotfiles-packages.txt
    }

    # Re-apply version pins/directives (e.g. "ffmpeg>=7") that the user added to
    # an existing list file, so `push` regenerating bare names from the installed
    # env doesn't drop them. $1 = existing file (may be absent). Reads plain
    # package names on stdin, prints name-or-pinned-spec lines.
    _dotfiles_keep_pins() {
      local existing="$1"
      if [[ ! -f "$existing" ]]; then
        cat
        return
      fi
      grep -vE '^[[:space:]]*#' "$existing" \
        | grep -E '^[A-Za-z0-9_.-]+[<>=!]' \
        | sort -u > /tmp/dotfiles-pins.txt
      while IFS= read -r name; do
        spec=$(awk -v n="$name" 'index($0, n)==1 { split($0,a,/[<>=!]/); if (a[1]==n) { print; exit } }' /tmp/dotfiles-pins.txt)
        printf '%s\n' "${spec:-$name}"
      done
    }

    if [[ -d "$HOME/.local/opt/miniforge3/conda-meta" ]]; then
      # Snapshot before writing: the group's `> "$pkgfile"` truncates the file,
      # so the pin-preserving filter must read a copy taken beforehand.
      cp -f "$pkgfile" /tmp/dotfiles-prev.txt 2>/dev/null || : > /tmp/dotfiles-prev.txt
      { printf '%s\n' "# Conda packages for local installs (no sudo/root needed)"
        printf '%s\n' "# Installed from conda-forge into the base env via sync.sh."
        printf '%s\n' "# Edit as needed."
        printf '%s\n' "#"
        printf '%s\n' "# Format: one package per line. Lines starting with # are comments."
        printf '%s\n' "# Packages also built locally from manlist.txt are skipped here."
        printf '%s\n' "# Version pins (e.g. ffmpeg>=7) are preserved across regenerations."
        printf '\n'
        _dotfiles_env_specs base | _dotfiles_keep_pins /tmp/dotfiles-prev.txt
      } > "$pkgfile"
      "${g[@]}" add -- .config/dotfiles/local/packages.txt
      if ! "${g[@]}" diff --cached --quiet -- \
          .config/dotfiles/local/packages.txt; then
        "${g[@]}" commit -m "chore: update package list"
      fi
    fi

    # Extra conda environments: one file per env under local/envs/<name>.txt,
    # regenerated from that env's explicit package list. Existing envs that
    # have no file yet get one created.
    local envsdir="$gitdir/local/envs"
    mkdir -p "$envsdir"
    local envdir envname envfile
    for envdir in "$HOME/.local/opt/miniforge3"/envs/*/; do
      [[ -d "$envdir" ]] || continue
      envname="$(basename "$envdir")"
      [[ -f "$envdir/conda-meta/history" ]] || continue
      envfile="$envsdir/$envname.txt"
      cp -f "$envfile" /tmp/dotfiles-prev.txt 2>/dev/null || : > /tmp/dotfiles-prev.txt
      { printf '%s\n' "# Extra conda environment '$envname' (no sudo/root needed)."
        printf '%s\n' "# Created via \`mamba create -n $envname -c conda-forge <packages>\`."
        printf '%s\n' "# Regenerated from this env's explicit package list by \`dotfiles push\`."
        printf '%s\n' "#"
        printf '%s\n' "# Format: one package per line. Lines starting with # are comments."
        printf '\n'
        _dotfiles_env_specs "$envname" | _dotfiles_keep_pins /tmp/dotfiles-prev.txt
      } > "$envfile"
      "${g[@]}" add -- ".config/dotfiles/local/envs/$envname.txt"
      if ! "${g[@]}" diff --cached --quiet -- \
          ".config/dotfiles/local/envs/$envname.txt"; then
        "${g[@]}" commit -m "chore: update env '$envname' package list"
      fi
    done
  fi

  if [[ "$1" == "push" && "$flow" == "arch" ]]; then
    local pkgfile="$gitdir/arch/packages.txt"
    local manlist="$gitdir/arch/manlist.txt"
    # Official repo packages + AUR/foreign packages, excluding packages that
    # sync.sh builds locally from manlist.txt (those are not installed via yay)
    # and makepkg *-debug artifacts.
    {
      pacman -Qqen
      pacman -Qqem
    } | grep -v -- '-debug$' | sort -u > /tmp/dotfiles-packages.txt
    if [[ -f "$manlist" ]]; then
      grep -vE '^[[:space:]]*#' "$manlist" | awk '{print $1}' | sort -u > /tmp/dotfiles-manlist.txt
      grep -vxFf /tmp/dotfiles-manlist.txt /tmp/dotfiles-packages.txt > /tmp/dotfiles-packages.filtered
      mv /tmp/dotfiles-packages.filtered /tmp/dotfiles-packages.txt
    fi
    { printf '%s\n' "# Arch packages (official repos + AUR), one per line."
      printf '%s\n' "# Installed with \`yay -S --needed\` (yay handles both). Edit as needed."
      printf '%s\n' "# Lines starting with # are comments."
      printf '\n'
      cat /tmp/dotfiles-packages.txt
    } > "$pkgfile"
    if ! "${g[@]}" diff --quiet -- \
        .config/dotfiles/arch/packages.txt; then
      "${g[@]}" add -- \
        .config/dotfiles/arch/packages.txt
      "${g[@]}" commit -m "chore: update package list"
    fi
  fi

  "${g[@]}" "$@"
  local rc=$?
  rm -f /tmp/dotfiles-packages.txt /tmp/dotfiles-manlist.txt /tmp/dotfiles-pins.txt /tmp/dotfiles-prev.txt

  if [[ "$1" == "pull" && $rc -eq 0 && "$flow" == "local" ]]; then
    "$gitdir/local/sync.sh"
  fi

  if [[ "$1" == "pull" && $rc -eq 0 && "$flow" == "arch" ]]; then
    "$gitdir/arch/sync.sh"
  fi
  return $rc
}
