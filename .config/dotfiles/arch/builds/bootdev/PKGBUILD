# Maintainer: generated by manfind.sh (in the same directory) — do not edit by hand
# upstream tag: v1.32.6
pkgname=bootdev
pkgver=1.32.6
pkgrel=1
pkgdesc="CLI used to complete coding challenges and lessons on Boot.dev"
arch=('x86_64')
url="https://github.com/bootdotdev/bootdev"
license=('MIT')
depends=()
makedepends=('go')
options=('!strip' '!debug')
source=("bootdev-1.32.6.tar.gz::https://github.com/bootdotdev/bootdev/archive/refs/tags/v1.32.6.tar.gz")
# GitHub tag-archive checksums are not guaranteed stable.
sha256sums=('SKIP')

build() {
  local top
  top=$(find "$srcdir" -mindepth 1 -maxdepth 1 -type d | head -n1)
  cd "$top" || return 1
  export CGO_ENABLED=0
  export GOPATH="$HOME/.local/opt/go"
  mkdir -p "$HOME/.local/opt/go"
  go build -trimpath -ldflags '-s -w' -o "bootdev" .
}

package() {
  local top
  top=$(find "$srcdir" -mindepth 1 -maxdepth 1 -type d | head -n1)
  cd "$top" || return 1
  install -Dm755 "bootdev" "$pkgdir/usr/bin/bootdev"
  if [[ -f LICENSE ]]; then
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/bootdev/LICENSE"
  fi
}
