package() {
  cd "$srcdir"
  # Keep npm's cache on the XDG path so the build doesn't create ~/.npm.
  # npm reads the uppercase form; prebuild-install (keytar) reads the lowercase form.
  export NPM_CONFIG_CACHE="$HOME/.cache/npm"
  export npm_config_cache="$HOME/.cache/npm"
  # Native deps (keytar) may build with cargo; keep it on a user-writable path.
  export CARGO_HOME="$HOME/.local/opt/cargo"
  npm_config_allow_scripts=keytar npm install -g --prefix "$pkgdir/usr" --no-fund --no-audit "$srcdir/leetcode-cli-3.6.2.tgz"
  if [[ -f package/LICENSE ]]; then
    install -Dm644 package/LICENSE "$pkgdir/usr/share/licenses/leetcode-cli/LICENSE"
  fi
}
