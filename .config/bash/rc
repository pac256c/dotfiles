# ~/.config/bash/rc - real bash config, sourced from the ~/.bash_profile and
# ~/.bashrc stubs. Purpose: load the shared env for EVERY bash shell, then
# (local/no-sudo machines) hand interactive shells off to zsh, which is only
# present inside the conda environment. The default login shell stays bash
# (no chsh needed); we activate conda here so `zsh` is on PATH, then exec it.


function _realpath() {
  local p="$1"
  if command -v realpath >/dev/null 2>&1; then
    realpath -e "$p" 2>/dev/null && return;
  fi
  echo "$p"
}

# Shared env first, so login/non-login/interactive/non-interactive bash all
# get it (non-interactive non-login also arrives here via $BASH_ENV).
[ -f $(_realpath "$HOME/.config/zsh/env") ] && . $(_realpath "$HOME/.config/zsh/env")

# Only hand off for interactive shells; never break non-interactive bash
# (scripts, `bash -c`, scp, etc.).
[[ $- == *i* ]] || return 0

# Guard against re-entry (e.g. if zsh is missing and bash gets restarted).
# [[ -n ${DOTFILES_BASH_HANDOFF:-} ]] && return 0

# zsh only exists in the conda env, so activate it if `zsh` isn't already found.
if ! command -v zsh >/dev/null 2>&1; then
  if [[ -f $(_realpath "$HOME/.local/opt/miniforge3/etc/profile.d/conda.sh") ]]; then
    # shellcheck disable=SC1091
    echo "starting conda"
    . $(_realpath "$HOME/.local/opt/miniforge3/etc/profile.d/conda.sh")
    conda activate base >/dev/null 2>&1 || true
  fi
fi

# If zsh is now available, exec it (zsh will source ~/.zshenv and ~/.zshrc,
# which re-activate conda and set up the full environment).
if command -v zsh >/dev/null 2>&1; then
  export DOTFILES_BASH_HANDOFF=1
  exec zsh
fi

# Non-interactive bash (BASH_ENV): if conda got activated above and we are not
# handing off to zsh, still defer conda's dirs so global binaries win.
type conda_defer_path >/dev/null 2>&1 && conda_defer_path
